theme=Tokyonight
# shift enter to send a new line
keybind=shift+enter=text:\x1b\r
font-size=16
font-family=IBM Plex Mono

# default window size
window-width=100
window-height=30
# denser tab bar layout
macos-titlebar-style=tabs

# Tmux keybinds are handled dynamically in Hammerspoon.
# cmd+t is taken by hammerspoon for new tmux window
keybind=cmd+shift+n=new_tab
