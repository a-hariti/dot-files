theme=Tokyonight
# shift enter to send a new line
keybind=shift+enter=text:\x1b\r
font-size=16
font-family=IBM Plex Mono

# default window size
window-width=100
window-height=30
# denser tab bar layout
macos-titlebar-style = tabs

# Tmux keybinds to make it macOS like
#		this maps cmd+<key> to my Tmux keybinds
#		tip: use xxd -psd to get the codex for keybinds
# <perfix>+c (new window)
keybind = super+t=text:\x01\x63
keybind = super+shift+t=new_tab
# <perfix>+x (close window)
keybind = super+x=text:\x01\x78
# cmd+j for a horizontal split (prefix -)
keybind = cmd+j=text:\x01\x2d
# cmd+l for a vertical split (prefix |)
keybind = cmd+l=text:\x01\x7c
# send prefix n (next window)
keybind= cmd+bracket_right=text:\x01\x6e
# send prefix p (previous window)
keybind= cmd+bracket_left=text:\x01\x70
# send prefix H (move window left)
keybind=cmd+shift+bracket_left=text:\x01\x48
# send prefix L (move window right)
keybind=cmd+shift+bracket_right=text:\x02\x4c
